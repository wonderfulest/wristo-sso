# Copy these values to the workspace-root environment file; Vite envDir is the parent directory.
# Apple web Services ID (public identifier). Both settings are required to show the button.
VITE_WRISTO_APPLE_CLIENT_ID=io.wristo.sso
# Exact HTTPS return URL registered with Apple, on this SSO site's origin.
VITE_WRISTO_APPLE_REDIRECT_URI=https://sso.wristo.io/login
